{
  "name": "task-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal projects & tasks manager with an MCP server for Claude Code",
  "license": "MIT",
  "author": "akaneghro",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "gen:keys": "tsx scripts/gen-keys.ts",
    "connect": "tsx scripts/connect.ts",
    "service:install": "tsx scripts/service.ts install",
    "service:update": "tsx scripts/service.ts update",
    "service:start": "tsx scripts/service.ts start",
    "service:stop": "tsx scripts/service.ts stop",
    "service:restart": "tsx scripts/service.ts restart",
    "service:status": "tsx scripts/service.ts status",
    "service:logs": "tsx scripts/service.ts logs",
    "service:uninstall": "tsx scripts/service.ts uninstall"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.3",
    "nuxt-auth-utils": "^0.5.34",
    "pinia": "^4.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
