# Copy to .env and fill in. Generate secrets with: pnpm gen:keys

# Session cookie encryption (32+ chars)
NUXT_SESSION_PASSWORD=

# GitHub OAuth App (https://github.com/settings/developers)
# Local callback URL: http://localhost:3000/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
# Optional, only if the callback URL differs from <site>/auth/github
NUXT_OAUTH_GITHUB_REDIRECT_URL=

# Owner of the app (the only account that can log in without an invitation)
NUXT_OWNER_GITHUB_LOGIN=
# Optional: pin the owner to a numeric GitHub id (survives username changes)
NUXT_OWNER_GITHUB_ID=

# Vault encryption key: base64 of 32 random bytes. Losing it makes stored secrets unrecoverable.
NUXT_VAULT_KEY=

# Database: local SQLite file, or Turso (libsql://<db>.turso.io + auth token)
NUXT_DATABASE_URL=file:./data/task-manager.db
NUXT_DATABASE_AUTH_TOKEN=

# Public URL of the app (used for share links)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Owner's time zone for server-side calendar dates (e.g. blocker "since")
NUXT_TIMEZONE=Europe/Madrid

# Development only: enables /auth/dev to log in as the owner without GitHub (never set in production)
NUXT_DEV_LOGIN=false

# Used only by `pnpm connect` (not by the app)
TM_URL=http://localhost:3000
TM_TOKEN=
